# Copy to .env. Never commit credentials.
# Select an installed model here, or select it in the Connections page.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=
AI_PROVIDER=ollama
# Prefer saving the Gemini key in Connections (OS credential store).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Google Cloud OAuth client type: Web application.
# Add this exact URI to Authorized redirect URIs. Match your server port.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8765/api/google/callback

# Google Maps Routes API and Places API (New) require a separate key and billing.
# See docs/GOOGLE_SETUP.md for OAuth and Maps setup.
GOOGLE_MAPS_API_KEY=

# Optional absolute storage directory; default is storage/runtime.
# INTENTOS_DATA_DIR=
